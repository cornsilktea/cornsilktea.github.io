{
  "compilerOptions": {
    "target": "ES2020",
    "module": "es2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "rootDir": "ts",
    "outDir": ".",
    "types": []
  },
  "include": ["ts/**/*.ts"],
  "exclude": ["node_modules"]
}
