{
  "rules": {
    "portal": {
      ".read": true,
      ".write": "auth != null && (auth.uid === 'use16pcii5RbEATuPtWhRDArmoj2' || auth.uid === 'HFcjiyXAl1YWzm3AyrZmzo4uMdG3')"
    },
    "castlespy": {
      ".read": true,
      "rooms": {
        "$room": { ".write": "$room.matches(/^[0-9]{5}$/)" }
      }
    },
    "volleyball": {
      ".read": true,
      "rooms": {
        "$room": { ".write": "$room.matches(/^[0-9]{5}$/)" }
      }
    },
    "soccer": {
      ".read": true,
      "rooms": {
        "$room": { ".write": "$room.matches(/^[0-9]{5}$/)" }
      }
    },
    "dungeonraid": {
      ".read": true,
      "rooms": {
        "$room": { ".write": "$room.matches(/^[0-9]{5}$/)" }
      }
    },
    "lasttile": {
      ".read": true,
      "rooms": {
        "$room": { ".write": "$room.matches(/^[0-9]{5}$/)" }
      }
    },
    "lasttilev2": {
      ".read": true,
      "rooms": {
        "$room": { ".write": "$room.matches(/^[0-9]{5}$/)" }
      }
    },
    "minigames": {
      ".read": true,
      "rooms": {
        "$room": { ".write": "$room.matches(/^[0-9]{5}$/)" }
      }
    },
    "teambattle": {
      ".read": true,
      "rooms": {
        "$room": { ".write": "$room.matches(/^[0-9]{5}$/)" }
      },
      "stats": {
        ".write": "auth != null && (auth.uid === 'use16pcii5RbEATuPtWhRDArmoj2' || auth.uid === 'HFcjiyXAl1YWzm3AyrZmzo4uMdG3')"
      },
      "modestats": {
        "$mode": {
          ".write": "(newData.exists() && ((!data.exists() && newData.child('matches').val() === 1) || (data.exists() && newData.child('matches').val() === data.child('matches').val() + 1))) || (auth != null && (auth.uid === 'use16pcii5RbEATuPtWhRDArmoj2' || auth.uid === 'HFcjiyXAl1YWzm3AyrZmzo4uMdG3'))",
          ".validate": "$mode.matches(/^(pvp|cup)$/) && newData.hasChildren(['matches', 'red', 'blue']) && newData.child('red').val() + newData.child('blue').val() <= newData.child('matches').val()",
          "matches": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "red": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "blue": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$char": {
            ".validate": "$char.matches(/^(warrior|knight|ranger|mage|rogue|necro|sniper|thrower|lancer|blacksmith|priest|hitman|guardian|frost|dancer|duelist|stormbow|cleric|shaman)$/) && newData.hasChildren(['picks', 'wins', 'dmg', 'heal']) && newData.child('wins').val() <= newData.child('picks').val() && ((!data.exists() && newData.child('picks').val() <= ($mode === 'cup' ? 1 : 6)) || (data.exists() && newData.child('picks').val() >= data.child('picks').val() && newData.child('picks').val() <= data.child('picks').val() + ($mode === 'cup' ? 1 : 6)))",
            "picks": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "wins": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "dmg": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
            "heal": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
            "block": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
            "stun": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600" },
            "slow": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600" },
            "assist": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "games": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().parent().child('matches').val()" },
            "asPicks": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('picks').val()" },
            "ccPicks": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('picks').val()" },
            "bans": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().parent().child('matches').val()" },
            "kills": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "deaths": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "kdPicks": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('picks').val()" },
            "draws": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('picks').val()" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "turbolap": {
      ".read": true,
      "rooms": {
        "$room": {
          ".write": "$room.matches(/^[0-9]{5}$/)",
          "players": {
            "$pid": {
              "nickname": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
              "team": { ".validate": "newData.isString() && newData.val().matches(/^(left|right|spec)$/)" }
            }
          },
          "st": {
            "$pid": { ".validate": "newData.isString() && newData.val().length <= 120" }
          }
        }
      }
    },
    "fpsbattle": {
      ".read": true,
      "rooms": {
        "$room": {
          ".write": "$room.matches(/^[0-9]{5}$/)",
          "players": {
            "$pid": {
              "nickname": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
              "team": { ".validate": "newData.isString() && newData.val().matches(/^(blue|red|spec)$/)" }
            }
          },
          "st": {
            "$pid": { ".validate": "newData.isString() && newData.val().length <= 80" }
          },
          "hits": {
            "$pid": {
              "$hit": {
                ".validate": "newData.hasChildren(['d', 'by']) && newData.child('d').isNumber() && newData.child('d').val() >= 0 && newData.child('d').val() <= 100"
              }
            }
          },
          "kills": {
            "$kill": { ".validate": "newData.hasChildren(['k', 'v', 'kt', 'vt', 'at'])" }
          },
          "items": {
            "$item": { ".validate": "newData.hasChildren(['k', 'x', 'z']) && newData.child('k').val().matches(/^(ammo|heal)$/)" }
          }
        }
      }
    },
    "zombieoutbreak": {
      ".read": true,
      "rooms": {
        "$room": {
          ".write": "$room.matches(/^[0-9]{5}$/)",
          "players": {
            "$pid": {
              "nickname": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
              "role": { ".validate": "newData.isString() && newData.val().matches(/^(human|zombie)$/)" }
            }
          },
          "st": {
            "$pid": { ".validate": "newData.isString() && newData.val().length <= 60" }
          }
        }
      }
    },
    "court": {
      ".read": true,
      "now": { ".write": true },
      "room": {
        "$room": { ".write": "$room.matches(/^[A-Z0-9]{4}$/)" }
      }
    },
    "ghosts": {
      ".read": true,
      "$game": {
        "$key": {
          ".write": "$game.matches(/^[a-z]+$/) && $key.matches(/^[a-z]+$/) && newData.child('score').val() === root.child('records').child($game).child($key).child('score').val()",
          ".validate": "newData.hasChildren(['score', 'name', 'data'])",
          "score": { ".validate": "newData.isNumber()" },
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "data": { ".validate": "newData.isString() && newData.val().length <= 120000" },
          "car": { ".validate": "newData.isString() && newData.val().matches(/^[a-z]+$/)" },
          "$other": { ".validate": false }
        }
      }
    },
    "records": {
      ".read": true,
      "$game": {
        "$key": {
          ".write": "$game.matches(/^[a-z]+$/) && $key.matches(/^[a-z]+$/) && (!data.exists() || newData.child('score').val() > data.child('score').val() || (auth != null && (auth.uid === 'use16pcii5RbEATuPtWhRDArmoj2' || auth.uid === 'HFcjiyXAl1YWzm3AyrZmzo4uMdG3')))",
          ".validate": "newData.hasChildren(['score', 'name', 'at']) && newData.child('score').isNumber() && newData.child('score').val() >= 0 && ($game !== 'slidecard' || newData.child('score').val() <= 999997500) && ($game !== 'robotmaze' || newData.child('score').val() <= 999999500) && ($game !== 'brickbreak' || newData.child('score').val() <= 500) && ($game !== 'snakegame' || newData.child('score').val() <= 399) && ($game !== 'conditionrun' || newData.child('score').val() <= 100) && ($game !== 'ramentiming' || newData.child('score').val() <= 50000) && ($game !== 'baseball' || newData.child('score').val() <= 300000) && ($game !== 'hanokroofrun' || newData.child('score').val() <= 50000) && ($game !== 'pianotiles' || newData.child('score').val() <= 1000000) && ($game !== 'timeguess' || newData.child('score').val() <= 1000000000) && ($game !== 'turbolap' || newData.child('score').val() <= 999955000) && ($game !== 'fpssurvival' || newData.child('score').val() <= 99999999) && ($game !== 'blockblast' || newData.child('score').val() <= 1000000) && ($game !== 'freekick' || newData.child('score').val() <= 10999) && ($game !== 'basketball' || newData.child('score').val() <= 100000) && ($game !== 'powerarrow' || newData.child('score').val() <= 600) && ($game !== 'dungeonraid' || (newData.child('score').val() <= 999820000 && newData.hasChild('party')))",
          "score": { ".validate": "newData.isNumber()" },
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "at": { ".validate": "newData.isNumber() && ((newData.val() > now - 600000 && newData.val() < now + 600000) || (auth != null && (auth.uid === 'use16pcii5RbEATuPtWhRDArmoj2' || auth.uid === 'HFcjiyXAl1YWzm3AyrZmzo4uMdG3')))" },
          "grade": { ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 2)" },
          "cls": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
          "party": {
            ".validate": "$game === 'dungeonraid' && newData.hasChildren(['0', '1', '2', '3', '4']) && !newData.hasChild('5')",
            "$i": { ".validate": "$i.matches(/^[0-4]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 8" }
          },
          "$other": { ".validate": false }
        }
      }
    },
    "seatplans": {
      ".read": true,
      "$cls": {
        ".indexOn": ["at"],
        "$id": {
          ".write": "$cls.matches(/^[12]-[1-5]$/) && (!data.exists() || (auth != null && (auth.uid === 'use16pcii5RbEATuPtWhRDArmoj2' || auth.uid === 'HFcjiyXAl1YWzm3AyrZmzo4uMdG3')))",
          ".validate": "newData.hasChildren(['mode', 'cells', 'at'])",
          "mode": { ".validate": "newData.isString() && newData.val().matches(/^(pair|exam)$/)" },
          "cells": { ".validate": "newData.isString() && newData.val().matches(/^(-1|0|[1-9][0-9]{0,2})(,(-1|0|[1-9][0-9]{0,2})){29}$/)" },
          "at": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
